modules = ["nodejs-22"]
run = "npm run db:migrate && npm run dev -- --hostname 0.0.0.0 --port 3000"

[packager]
language = "nodejs"
ignoredPaths = ["node_modules", ".next"]

[packager.features]
guessImports = false
packageSearch = true
enabledForHosting = false

[deployment]
build = "npm ci --include=dev && npm run build"
run = "npm run db:migrate && npm run start -- --hostname 0.0.0.0 --port 3000"

[[ports]]
localPort = 3000
externalPort = 80
