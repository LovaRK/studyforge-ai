# Copy to .env.local for local development. On Replit, add these in Tools → Secrets.
# Never commit real values.

# Postgres. Locally, `npm run db:up` starts a container using these credentials.
DATABASE_URL=postgres://studyforge:change-me@localhost:5432/studyforge

# Sign-in. The password is hashed into the database on first boot.
OWNER_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# LLM provider: gemini (default) or mock (offline, used by tests and CI).
LLM_PROVIDER=gemini
# Free key from Google AI Studio.
GEMINI_API_KEY=
# A Flash / Flash-Lite model from GET https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.5-flash-lite

